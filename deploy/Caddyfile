# Only https://{$SITE}/{$PREFIX}/... serves the app; every other path is a bare 404.
{
	admin off
}

{$SITE} {
	header {
		-Server
		-Via
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Access-Control-Allow-Origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "microphone=(self), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
	}
	# compress text (HTML / JS / CSS / JSON); responses that are already encoded are passed through as they are
	encode zstd gzip
	request_body {
		max_size 200MB
	}
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	redir /{$PREFIX} /{$PREFIX}/ 308
	handle_path /{$PREFIX}/* {
		reverse_proxy {$UPSTREAM:app:8000} {
			header_down -Server
			header_down -Access-Control-Allow-Origin
			transport http {
				response_header_timeout 300s
			}
		}
	}
	handle {
		respond 404
	}
}
